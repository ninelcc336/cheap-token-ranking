---
import BaseLayout from '../layouts/BaseLayout.astro';
import { iqQuestions } from '../data/iq-tests';

const questions = iqQuestions;

/** 推理强度徽章配色：high 红、medium 黄、low 绿，其余用中性色。 */
const effortClassNames: Record<string, string> = {
  high: 'strength-badge--high',
  medium: 'strength-badge--medium',
  low: 'strength-badge--low',
};

const getEffortClass = (effort: string) => effortClassNames[effort.toLowerCase()] ?? 'strength-badge--default';

// 统一基础路径格式，确保返回榜单链接在 GitHub Pages 项目站点中有效。
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const homeHref = base;
---

<BaseLayout
  title="智商检测题 · Token 中转性价比榜"
  description="把检测题原文复制发给中转站背后的模型，验证它是否真的能打；每题附结果与推荐搭配的模型、强度。"
>
  <section class="page-intro page-intro--compact" aria-labelledby="iq-title">
    <div>
      <p class="eyebrow">IQ CHECK / SANITY TEST</p>
      <h1 id="iq-title">智商检测题</h1>
      <p class="intro-copy">把题目原文复制发给中转站背后的模型，对照结果验证它是否真的能打；每题标注推荐搭配的模型与强度。</p>
    </div>
    <div class="intro-meta">
      <span class="meta-label">题目数量</span>
      <strong>{questions.length}</strong>
      <a class="text-link" href={homeHref}>返回排行榜 <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="ranking-section" aria-labelledby="iq-list-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">QUESTION BANK</p>
        <h2 id="iq-list-title">检测题目</h2>
      </div>
      <span class="result-count">共 {questions.length} 道题目</span>
    </div>

    <div class="iq-list-wrap">
      {questions.map((question, index) => (
        <article class="q-card" data-iq-card>
          <header class="q-card-head">
            <div class="q-card-title">
              <span class="q-index">{String(index + 1).padStart(2, '0')}</span>
              <h3>{question.title}</h3>
            </div>
            <button class="copy-btn" type="button" data-copy-btn>
              <span data-copy-label>复制题目</span>
            </button>
          </header>

          <div class="q-models">
            <span class="q-models-label">推荐模型</span>
            <span class="model-chip model-chip--accent">{question.model}</span>
            <span class="q-models-label">强度</span>
            <span class={`strength-badge ${getEffortClass(question.effort)}`}>{question.effort}</span>
          </div>

          <div class="q-prompt">
            <pre class="q-prompt-text"><code>{question.prompt}</code></pre>
          </div>

          <div class="q-subsection">
            <span class="q-subsection-title">结果</span>
            <p class="q-answer-text">{question.answer}</p>
          </div>

          {question.references.length > 0 && (
            <div class="q-subsection">
              <span class="q-subsection-title">引用链接</span>
              <ul class="q-ref-list">
                {question.references.map((reference) => (
                  <li>
                    <a
                      href={reference.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${reference.label}（新窗口打开）`}
                    >{reference.label}<span class="external-mark" aria-hidden="true">↗</span></a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </article>
      ))}
    </div>
  </section>

  <section class="source-band" aria-labelledby="iq-source-title">
    <div>
      <p class="eyebrow">DATA NOTE</p>
      <h2 id="iq-source-title">使用边界</h2>
    </div>
    <div class="source-copy">
      <p>题目与结果由本站人工上传维护；推荐模型与强度只代表该题的验证配置，不是模型排名。模型表现会随提示词、温度和上下文波动，建议同题多测几次再下结论；答错也可能只是采样波动，不一定意味着中转站降智。</p>
      <p>榜单侧的性价比数据见<a class="text-link" href={homeHref}>排行榜</a>，计算口径见说明页。</p>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/iq';
  import '../scripts/theme';
</script>

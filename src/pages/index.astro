---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  expandPlans,
  formatMetric,
  getAvailableChannels,
  getAvailableModels,
  getLatestMeasuredDate,
  getRankedPlans,
  modelRates,
} from '../data/plans';

const expiredLabel = '已过期';

const modelLabels = {
  GPT: 'GPT',
  Claude: 'Claude',
  Grok: 'Grok',
  Gemini: 'Gemini',
  Other: '其他',
} as const;

const offerLabels = {
  standard: '倍率套餐',
  bundle: '特殊捆绑包',
} as const;

const channelClassNames: Record<string, string> = {
  Plus: 'channel-label--plus',
  Pro: 'channel-label--pro',
  kiro: 'channel-label--kiro',
  max: 'channel-label--max',
  aws: 'channel-label--aws',
  cursor: 'channel-label--cursor',
  max稳定: 'channel-label--max-stable',
  '1M稳定': 'channel-label--1m-stable',
  '1M': 'channel-label--1m',
  反重力: 'channel-label--antigravity',
  高缓: 'channel-label--high-buffer',
};

/** 将渠道名称映射为稳定的视觉样式；未来新增渠道使用中性颜色回退。 */
function getChannelClass(channel: string): string {
  return channelClassNames[channel] ?? 'channel-label--default';
}

const formatDate = (date: string) => date.replaceAll('-', '.');
const expandedPlans = expandPlans();
const models = getAvailableModels();
const modelEntries = models.map((model) => ({
  model,
  channels: getAvailableChannels(modelRates, model),
  plans: getRankedPlans(model, expandedPlans),
}));
const activeEntry = modelEntries[0];
const activeModel = activeEntry?.model ?? 'GPT';
const activePlans = activeEntry?.plans ?? [];
const rankedPlans = modelEntries.flatMap(({ plans }) => plans);
const latestMeasuredDate = getLatestMeasuredDate();
// 统一基础路径格式，确保普通项目仓库部署时的链接不会和路径片段粘连。
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const methodHref = `${base}method/`;
---

<BaseLayout
  title="Token 中转性价比榜"
  description="按每元有效额度比较 Token 中转方案，按模型分别提供 GPT、Claude 等排行榜。"
>
  <section class="page-intro" aria-labelledby="page-title">
    <div>
      <p class="eyebrow">PRICE / VALUE INDEX</p>
      <h1 id="page-title">Token 中转性价比榜</h1>
      <p class="intro-copy">用同一套口径比较不同中转站与模型渠道；不同模型分别排名，不跨模型合并名次。</p>
    </div>
    <div class="intro-meta">
      <span class="meta-label">最近测评</span>
      <strong>{formatDate(latestMeasuredDate)}</strong>
      <a class="text-link" href={methodHref}>了解计算口径 <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="summary-strip" aria-label="榜单摘要">
    <div class="summary-item">
      <span>当前模型记录</span>
      <strong id="summary-count">{activePlans.length}</strong>
    </div>
    <div class="summary-item">
      <span>当前最高每元有效额度</span>
      <strong id="summary-top-value">{formatMetric(activePlans[0]?.valuePerYuan ?? 0)}</strong>
    </div>
    <div class="summary-item">
      <span>数据更新</span>
      <strong>{formatDate(latestMeasuredDate)}</strong>
    </div>
    <div class="summary-note">
      <span class="source-dot" aria-hidden="true"></span>
      <span id="summary-note">当前显示 {modelLabels[activeModel]}，模型独立排名；数据来自官方网站人工采集</span>
    </div>
  </section>

  <section class="ranking-section" aria-labelledby="ranking-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">COMPARISON TABLE</p>
        <h2 id="ranking-title">{modelLabels[activeModel]} 方案排名</h2>
      </div>
      <span id="result-count" class="result-count">{modelLabels[activeModel]} 显示 {activePlans.length} 条记录</span>
    </div>

    <div class="model-tabs" role="tablist" aria-label="模型排行榜">
      {modelEntries.map((entry, index) => (
        <button
          id={`model-tab-${index}`}
          class="model-tab"
          type="button"
          role="tab"
          aria-controls="ranking-panel"
          aria-selected={index === 0}
          data-model-tab={entry.model}
          data-model-label={modelLabels[entry.model]}
          data-channels={JSON.stringify(entry.channels)}
        >
          <span class="model-tab-label">{modelLabels[entry.model]}</span>
        </button>
      ))}
    </div>

    <div id="ranking-panel" class="ranking-panel" role="tabpanel" aria-labelledby="model-tab-0">
      <div class="toolbar" aria-label="榜单筛选工具">
        <label class="search-field">
          <span class="sr-only">搜索中转站或渠道</span>
          <span class="search-icon" aria-hidden="true"></span>
          <input id="plan-search" type="search" placeholder="搜索中转站 / 渠道" autocomplete="off" />
        </label>
        <label class="select-field">
          <span class="field-label">渠道</span>
          <select id="channel-filter">
            <option value="all">全部渠道</option>
            {activeEntry?.channels.map((channel) => <option value={channel}>{channel}</option>)}
          </select>
        </label>
        <label class="select-field select-field--sort">
          <span class="field-label">排序</span>
          <select id="sort-select">
            <option value="value">性价比优先</option>
            <option value="effective">有效额度</option>
            <option value="recharge">充值金额</option>
            <option value="multiplier">倍率</option>
            <option value="name">名称</option>
          </select>
        </label>
      </div>

      <div class="table-wrap">
        <table class="ranking-table" id="ranking-table">
          <colgroup>
            <col class="col-rank" />
            <col class="col-name" />
            <col class="col-channel" />
            <col class="col-multiplier" />
            <col class="col-recharge" />
            <col class="col-face" />
            <col class="col-effective" />
            <col class="col-value" />
            <col class="col-updated" />
          </colgroup>
          <thead>
            <tr>
              <th scope="col">排名</th>
              <th scope="col">中转站</th>
              <th scope="col">渠道</th>
              <th scope="col" class="numeric">倍率</th>
              <th scope="col" class="numeric">充值 / 元</th>
              <th scope="col" class="numeric">面值 / $</th>
              <th scope="col" class="numeric">有效额度</th>
              <th scope="col" class="numeric emphasis-head">每元有效额度</th>
              <th scope="col">更新时间</th>
            </tr>
          </thead>
          <tbody id="table-body">
            {rankedPlans.map((plan) => (
              <tr
                hidden={plan.model !== activeModel}
                class:list={{ 'plan-row': true, 'is-expired': plan.status === 'expired' }}
                data-plan-item
                data-name={plan.stationName.toLowerCase()}
                data-search={`${plan.stationName} ${plan.channel} ${plan.offerLabel ?? ''}`.toLowerCase()}
                data-model={plan.model}
                data-channel={plan.channel}
                data-value={plan.valuePerYuan}
                data-effective={plan.effectiveAmount}
                data-recharge={plan.rechargeAmount}
                data-multiplier={plan.multiplier}
              >
                <td class="rank-cell"><span class="rank-number">{plan.rank.toString().padStart(2, '0')}</span></td>
                <td>
                  <div class="plan-name">
                    <a
                      class="plan-link"
                      href={plan.website}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${plan.stationName}官网（新窗口打开）`}
                    >{plan.stationName}<span class="external-mark" aria-hidden="true">↗</span></a>
                  </div>
                </td>
                <td>
                  <span class={`channel-label ${getChannelClass(plan.channel)}`}>{plan.channel}</span>
                  {plan.status === 'expired' && <span class="expired-marker">{expiredLabel}</span>}
                </td>
                <td class="numeric">{formatMetric(plan.multiplier)}×</td>
                <td class="numeric">{formatMetric(plan.rechargeAmount)}</td>
                <td class="numeric">{formatMetric(plan.faceValue)}</td>
                <td class="numeric">{formatMetric(plan.effectiveAmount)}</td>
                <td class="numeric value-cell">{formatMetric(plan.valuePerYuan)}</td>
                <td><time class="updated-at" datetime={plan.measuredAt}>{formatDate(plan.measuredAt)}</time></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="mobile-list" id="mobile-list" aria-label="中转站列表">
        {rankedPlans.map((plan) => (
          <article
            hidden={plan.model !== activeModel}
            class:list={{ 'plan-card': true, 'is-expired': plan.status === 'expired' }}
            data-plan-item
            data-name={plan.stationName.toLowerCase()}
            data-search={`${plan.stationName} ${plan.channel} ${plan.offerLabel ?? ''}`.toLowerCase()}
            data-model={plan.model}
            data-channel={plan.channel}
            data-value={plan.valuePerYuan}
            data-effective={plan.effectiveAmount}
            data-recharge={plan.rechargeAmount}
            data-multiplier={plan.multiplier}
          >
            <div class="plan-card-head">
              <div>
                <span class="rank-number">{plan.rank.toString().padStart(2, '0')}</span>
                <h3>
                  <a
                    class="plan-link"
                    href={plan.website}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${plan.stationName}官网（新窗口打开）`}
                  >{plan.stationName}<span class="external-mark" aria-hidden="true">↗</span></a>
                </h3>
              </div>
              <time class="updated-at" datetime={plan.measuredAt}>{formatDate(plan.measuredAt)}</time>
            </div>
            <div class="card-tags">
              <span class={`channel-label ${getChannelClass(plan.channel)}`}>{plan.channel}</span>
              {plan.status === 'expired' && <span class="expired-marker">{expiredLabel}</span>}
              <span>{offerLabels[plan.offerKind]}{plan.offerLabel ? ` · ${plan.offerLabel}` : ''}</span>
            </div>
            <dl class="card-metrics">
              <div><dt>倍率</dt><dd>{formatMetric(plan.multiplier)}×</dd></div>
              <div><dt>充值</dt><dd>{formatMetric(plan.rechargeAmount)} 元</dd></div>
              <div><dt>面值</dt><dd>{formatMetric(plan.faceValue)} $</dd></div>
              <div><dt>有效额度</dt><dd>{formatMetric(plan.effectiveAmount)}</dd></div>
            </dl>
            <div class="card-value">
              <span>每元有效额度</span>
              <strong>{formatMetric(plan.valuePerYuan)}</strong>
            </div>
          </article>
        ))}
      </div>

      <div class="empty-state" id="empty-state" hidden>
        <strong>没有匹配的方案</strong>
        <span>请调整搜索词、渠道或排序条件。</span>
      </div>
    </div>
  </section>

  <section class="source-band" aria-labelledby="source-title">
    <div>
      <p class="eyebrow">DATA NOTE</p>
      <h2 id="source-title">数据来源与边界</h2>
    </div>
    <div class="source-copy">
      <p>本页数据由用户从官方网站人工采集，测评日期为 {formatDate(latestMeasuredDate)}。金额、面值和倍率均按原始记录计算，未做汇率换算。</p>
      <p>GPT、Claude 等模型使用各自独立的排名；榜单仅反映给定口径下的数值比较，不代表服务稳定性、可用模型、退款政策或长期有效性。购买前请以服务方最新说明为准。</p>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/ranking';
</script>
